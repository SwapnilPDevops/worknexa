# Copy to docker/.env.staging or docker/.env.production, fill in, and keep the copy out of source control.
# Generate secrets with:  openssl rand -base64 48

# Docker project name; use worknexa-staging for staging when it shares a host with production.
COMPOSE_PROJECT_NAME=worknexa
# staging | production; tags logs and traces.
DEPLOYMENT_ENVIRONMENT=production
# Image tag. Roll back by setting the previous tag.
WORKNEXA_VERSION=1.0.0

# Public URL users open (scheme + host, no trailing slash). Must be HTTPS outside a local smoke test.
PUBLIC_ORIGIN=https://worknexa.example.com

# Web server binding. Keep 127.0.0.1 when a reverse proxy on the same host terminates TLS.
WEB_BIND=127.0.0.1
WEB_PORT=8080
# Address range of the TLS terminator allowed to set X-Forwarded-For / X-Forwarded-Proto.
TRUSTED_PROXY_CIDR=127.0.0.1/32
# Subnet for the web-to-api network; change only if it collides with an existing network.
EDGE_SUBNET=172.30.0.0/24

# Database. Avoid ';' in the password because it ends a connection-string field.
POSTGRES_DB=worknexa_db
POSTGRES_USER=worknexa
POSTGRES_PASSWORD=

# At least 32 characters. Rotating it signs everyone out.
AUTH_SIGNING_KEY=

# Optional features; leave empty to disable.
OPENAI_API_KEY=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_TENANT_ID=common

# Optional OpenTelemetry export (traces and metrics). Logs always go to stdout as JSON.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# Image names when pulling from a registry instead of building on the host.
WORKNEXA_API_IMAGE=worknexa-api
WORKNEXA_WEB_IMAGE=worknexa-web
