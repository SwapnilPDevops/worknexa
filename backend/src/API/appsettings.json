{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System.Net.Http.HttpClient": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ]
  },
  "AllowedHosts": "*",
  "ApiDocs": {
    "Enabled": false
  },
  "ForwardedHeaders": {
    "Enabled": false,
    "KnownNetworks": [],
    "KnownProxies": []
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Auth": {
    "Issuer": "worknexa",
    "Audience": "worknexa",
    "TokenHours": 8
  },
  "RateLimits": {
    "LoginPerMinute": 10,
    "PasswordChangePerMinute": 5,
    "AssistantChatPerMinute": 20
  },
  "Pagination": {
    "DefaultPageSize": 20,
    "MaxPageSize": 100
  },
  "Assistant": {
    "Provider": "OpenAI",
    "MaxToolRounds": 4,
    "ProposalMinutes": 10,
    "MaxHistoryMessages": 20,
    "OpenAI": {
      "Model": "gpt-4o-mini",
      "BaseUrl": "https://api.openai.com/v1",
      "TimeoutSeconds": 60
    }
  },
  "Integrations": {
    "BackgroundSync": true,
    "IntervalMinutes": 15,
    "PastDays": 30,
    "FutureDays": 180,
    "CursorMaxAgeDays": 7,
    "RunsKept": 50,
    "ReturnUrl": "/settings",
    "Outlook": {
      "ClientId": "",
      "TenantId": "common",
      "RedirectUri": "http://127.0.0.1:5174/api/integrations/oauth/callback"
    }
  }
}
