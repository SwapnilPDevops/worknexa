# Rendered by the nginx image entrypoint (envsubst) into /etc/nginx/conf.d/default.conf.
#   API_UPSTREAM        where /api is proxied, e.g. http://api:8080
#   TRUSTED_PROXY_CIDR  load balancer / TLS terminator allowed to set X-Forwarded-For and X-Forwarded-Proto

# Only a trusted proxy may tell us the original scheme; everyone else gets the scheme of this connection.
geo $realip_remote_addr $from_trusted_proxy {
    default 0;
    ${TRUSTED_PROXY_CIDR} 1;
}

map "$from_trusted_proxy:$http_x_forwarded_proto" $forwarded_proto {
    "~^1:(?<proto>https?)$" $proto;
    default $scheme;
}

server {
    listen 8080;
    server_name _;
    server_tokens off;
    root /usr/share/nginx/html;

    set_real_ip_from ${TRUSTED_PROXY_CIDR};
    real_ip_header X-Forwarded-For;
    real_ip_recursive on;

    # Attachments are capped at 10 MB by the API; leave room for multipart overhead.
    client_max_body_size 11m;

    gzip on;
    gzip_min_length 1024;
    gzip_types text/css application/javascript application/json image/svg+xml;

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok";
    }

    location /api/ {
        proxy_pass ${API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $forwarded_proto;
        proxy_set_header Connection "";
        # The assistant waits on the model provider for up to a minute.
        proxy_read_timeout 120s;
    }

    # Vite output: content-hashed file names, safe to cache forever.
    location ~* "^/assets/.+-[A-Za-z0-9_-]{8,}\.(js|css|woff2?|svg|png|jpg|webp)$" {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        try_files $uri =404;
    }

    location / {
        include /etc/nginx/snippets/security-headers.conf;
        # index.html and unhashed public files must be revalidated so a deploy is picked up immediately.
        add_header Cache-Control "no-cache" always;
        try_files $uri /index.html;
    }
}
